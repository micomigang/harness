# Core runtime
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8788
HARNESS_DATA_DIR=./data
HARNESS_PROVIDER=kimi-seedance

# OpenAI-compatible LLM (Kimi can be configured here)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.moonshot.cn/v1
OPENAI_COMPAT_MODEL=kimi-k2.6
SOURCE_FRAME_COUNT=6
SOURCE_FRAME_WIDTH=768

# Volcengine Ark Seedream reference images
IMAGE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_API_KEY=
IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_SIZE=2K
IMAGE_MAX_ASSETS=6

# Generic video generation adapter
VIDEO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_API_KEY=
VIDEO_MODEL=doubao-seedance-2-5-260628
VIDEO_FALLBACK_MODEL=doubao-seedance-2-0-260128
VIDEO_RESOLUTION=720p
VIDEO_RATIO=9:16
VIDEO_GENERATE_AUDIO=true
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_TIMEOUT_SECONDS=900
VIDEO_BATCH_MAX_SHOTS=8

# Local final composition
FFMPEG_PATH=F:\oiioii-harness\tools\ffmpeg-release\ffmpeg-9.0.1-essentials_build\bin\ffmpeg.exe

# Generic music / sound generation adapter
AUDIO_API_BASE_URL=
AUDIO_API_KEY=
AUDIO_MODEL=

# Optional Volcengine French TTS (separate speech credentials, not the Ark key)
TTS_API_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_VOICE_TYPE=
TTS_LANGUAGE=fr
TTS_RESOURCE_ID=seed-tts-1.1

# Optional Volcengine ASR for source-video transcription
ASR_API_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_API_KEY=
ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# Optional object storage used by remote media APIs
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# Optional webhook base URL for asynchronous providers
PUBLIC_WEBHOOK_BASE_URL=
